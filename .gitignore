# 调试截图与诊断产物（由 scripts/cdp_shot.py 等生成，随时可重建）
shots/
shots_*/
scripts/shots/

# Python 缓存
__pycache__/
*.pyc

# 系统文件
Thumbs.db
.DS_Store

# Godot local import cache and generated visual checks
godot/.godot/
godot/captures/

# Local downloaded source packs and conversion workspace (runtime exports live in godot/assets)
/tempassets/

# Blender authoring files and backups remain local
/art/**/*.blend
/art/**/*.blend[0-9]*
/art/**/*.log

# Local, hash-checked pre-recovery snapshots and native verification captures.
/recovery-backups/

# Local experiment scratch space. Keep the supplied reference video in place,
# but do not include it or disposable captures in Git changes.
/tmp/
/godot/tempassets/

# Cave benchmark specs and written conclusions remain visible to Git. Native
# capture runs, frame sequences and engine logs are reproducible local output.
/scene-production/jobs/cave-c1-benchmark/algorithm-lab/game-*/
/scene-production/jobs/cave-c1-benchmark/algorithm-lab/native-*/
/scene-production/jobs/cave-c1-benchmark/algorithm-lab/pipeline-*/
/scene-production/jobs/cave-c1-benchmark/algorithm-lab/run-*/
/scene-production/jobs/cave-c1-benchmark/algorithm-lab/performance-*/
/scene-production/jobs/cave-c1-benchmark/**/*.png
/scene-production/jobs/cave-c1-benchmark/**/*.gif
/scene-production/jobs/cave-c1-benchmark/**/*.log
